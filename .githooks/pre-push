#!/bin/sh
set -eu

if [ -z "${ANDROID_HOME:-}" ] && [ -d "$HOME/Android/Sdk" ]; then
  export ANDROID_HOME="$HOME/Android/Sdk"
fi

if [ -z "${JAVA_HOME:-}" ]; then
  java_major="$(java -version 2>&1 | sed -n 's/.*version "\([0-9]*\).*/\1/p' | head -n 1)"
  if [ -z "$java_major" ] || [ "$java_major" -gt 24 ] || [ "$java_major" -lt 17 ]; then
    for candidate in /nix/store/*-openjdk-21*/lib/openjdk /usr/lib/jvm/java-21-* /usr/lib/jvm/temurin-21-*; do
      if [ -x "$candidate/bin/java" ]; then
        export JAVA_HOME="$candidate"
        export PATH="$JAVA_HOME/bin:$PATH"
        break
      fi
    done
  fi
fi

dotnet test ContextAll.Tests.slnf -c Release --nologo
./scripts/test-e2e.sh --all
./gradlew :app:testDebugUnitTest :app:lintDebug --no-daemon
