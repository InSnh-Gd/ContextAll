<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot Condition="'$(OS)' != 'Windows_NT' and !$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ContextAll.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContextAll.Core\ContextAll.Core.csproj" />
    <ProjectReference Include="..\ContextAll.Ipc\ContextAll.Ipc.csproj" />
    <ProjectReference Include="..\ContextAll.Effects\ContextAll.Effects.csproj" />
    <ProjectReference Include="..\ContextAll.Session\ContextAll.Session.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ContextAll.Session" />
    <Using Include="ContextAll.Session.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.50.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
