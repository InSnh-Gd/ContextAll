<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContextAll.App\ContextAll.App.csproj" />
    <ProjectReference Include="..\ContextAll.Host\ContextAll.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.4" />
  </ItemGroup>

  <Target Name="IncludeHostDependenciesInPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)ContextAll.Host.deps.json">
        <RelativePath>ContextAll.Host.deps.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
