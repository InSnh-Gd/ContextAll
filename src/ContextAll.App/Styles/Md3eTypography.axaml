<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MD3E 15 Emphasized typographic roles complementing CCSWE 15 baseline scales + MonoTabular -->

  <Style Selector="TextBlock.DisplayLargeEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="57" />
    <Setter Property="LineHeight" Value="64" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.5" />
  </Style>
  <Style Selector="TextBlock.DisplayMediumEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="45" />
    <Setter Property="LineHeight" Value="52" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.25" />
  </Style>
  <Style Selector="TextBlock.DisplaySmallEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="36" />
    <Setter Property="LineHeight" Value="44" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.HeadlineLargeEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LineHeight" Value="40" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.HeadlineMediumEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.HeadlineSmallEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.TitleLargeEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.TitleMediumEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.1" />
  </Style>
  <Style Selector="TextBlock.TitleSmallEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.1" />
  </Style>

  <Style Selector="TextBlock.BodyLargeEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.15" />
  </Style>
  <Style Selector="TextBlock.BodyMediumEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.2" />
  </Style>
  <Style Selector="TextBlock.BodySmallEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.3" />
  </Style>

  <Style Selector="TextBlock.LabelLargeEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.1" />
  </Style>
  <Style Selector="TextBlock.LabelMediumEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.4" />
  </Style>
  <Style Selector="TextBlock.LabelSmallEmphasized">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.4" />
  </Style>

  <Style Selector="TextBlock.MonoTabular">
    <Setter Property="FontFamily" Value="{DynamicResource Md3MonospaceFontFamily}" />
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>

  <Style Selector="SelectableTextBlock.MonoTabular">
    <Setter Property="FontFamily" Value="{DynamicResource Md3MonospaceFontFamily}" />
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>

  <Style Selector="TextBox.MonoTabular">
    <Setter Property="FontFamily" Value="{DynamicResource Md3MonospaceFontFamily}" />
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>

  <Style Selector="Border.StatusPill">
    <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
  </Style>
  <Style Selector="Border.StatusPill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
  </Style>
  <Style Selector="Border.StatusPill.Error">
    <Setter Property="Background" Value="{DynamicResource ErrorContainer}" />
  </Style>
  <Style Selector="Border.StatusPill.Error TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnErrorContainer}" />
  </Style>
  <Style Selector="Border.StatusPill.Ready">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
  </Style>
  <Style Selector="Border.StatusPill.Ready TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
  </Style>
  <Style Selector="Border.StatusPill.Muted">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
  </Style>
  <Style Selector="Border.StatusPill.Muted TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
  </Style>

  <Style Selector="Border.GuideDot">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
  </Style>
  <Style Selector="Border.GuideDot.Active">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
  </Style>

  <Style Selector="Button.FilledTonal.GroupSelected">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.FilledTonal.GroupSelected /template/ Border#PART_StateLayer">
    <Setter Property="Background" Value="{DynamicResource OnPrimary}" />
  </Style>

  <Style Selector="TextBox.Filled">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBox.Filled:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
</Styles>
