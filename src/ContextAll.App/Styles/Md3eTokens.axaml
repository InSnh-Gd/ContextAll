<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MD3E 8-level corner radii -->
  <CornerRadius x:Key="Md3eCornerNone">0</CornerRadius>
  <CornerRadius x:Key="Md3eCornerExtraSmall">4</CornerRadius>
  <CornerRadius x:Key="Md3eCornerGroupInner">6</CornerRadius>
  <CornerRadius x:Key="Md3eCornerSmall">8</CornerRadius>
  <CornerRadius x:Key="Md3eCornerPressed">12</CornerRadius>
  <CornerRadius x:Key="Md3eCornerMedium">16</CornerRadius>
  <CornerRadius x:Key="Md3eCornerLarge">20</CornerRadius>
  <CornerRadius x:Key="Md3eCornerGroupOuter">24</CornerRadius>
  <CornerRadius x:Key="Md3eCornerSheet">28</CornerRadius>
  <CornerRadius x:Key="Md3eCornerFull">9999</CornerRadius>

  <!-- Layout dimension constants -->
  <x:Double x:Key="Md3eOuterSheetGap">12</x:Double>
  <x:Double x:Key="Md3eHeaderHeight">48</x:Double>
  <x:Double x:Key="Md3eLeftDevicesWidth">404</x:Double>
  <x:Double x:Key="Md3eLeftTransfersWidth">400</x:Double>
  <x:Double x:Key="Md3eRailCollapsedWidth">96</x:Double>
  <x:Double x:Key="Md3eRailExpandedWidth">224</x:Double>

  <!-- Font fallback before live LinuxAppearanceCoordinator overrides -->
  <FontFamily x:Key="Md3MonospaceFontFamily">JetBrains Mono, Noto Sans Mono, Monospace</FontFamily>

