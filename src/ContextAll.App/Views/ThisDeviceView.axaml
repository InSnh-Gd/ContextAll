<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContextAll.App.ViewModels"
             xmlns:controls="using:ContextAll.App.Controls"
             x:Class="ContextAll.App.Views.ThisDeviceView"
             x:DataType="vm:ThisDeviceViewModel">
  <UserControl.Styles>
    <Style Selector="ScrollViewer#SettingsScroll controls|ExpressiveGroupTile">
      <Setter Property="GroupOuterRadius" Value="24" />
      <Setter Property="MinHeight" Value="72" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="controls|ExpressiveGroupTile TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Grid ColumnDefinitions="Auto,*">
    <ListBox x:Name="Categories" IsVisible="False" Width="152" Margin="0,8,12,0" VerticalAlignment="Top" AutomationProperties.Name="本机设置分类" />
    <ScrollViewer Grid.Column="1" x:Name="SettingsScroll" Padding="16,8,16,24"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Stretch">
        <StackPanel Spacing="4">
          <TextBlock Text="本机设置"
                     Classes="HeadlineSmallEmphasized" />
          <TextBlock Text="管理本机名称、文件保存位置、外观配色与后台服务"
                     Classes="BodyMedium"
                     Foreground="{DynamicResource OnSurfaceVariant}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="StatusBanner"
                Classes="StatusPill"
                Classes.Error="{Binding StatusIsError}"
                CornerRadius="16"
                Padding="14,10"
                IsVisible="{Binding HasStatusMessage}">
          <TextBlock x:Name="StatusText"
                     Classes="BodyMedium"
                     Text="{Binding StatusMessage}"
                     TextWrapping="Wrap" />
        </Border>

        <StackPanel x:Name="IdentitySection" Spacing="10">
          <TextBlock Text="本机身份"
                     Classes="LabelLarge"
                     Foreground="{DynamicResource Primary}"
                     Margin="8,0,0,0" />
          <StackPanel Spacing="2">
            <controls:ExpressiveGroupTile x:Name="NameTile" Position="First">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <controls:ExpressiveIconBadge Grid.Column="0"
                                              ContainerSize="44"
                                              IconSize="22"
                                              Tone="Primary"
                                              VerticalAlignment="Center"
                                              PathData="M20,3H4C2.9,3 2,3.9 2,5v10c0,1.1 0.9,2 2,2h6v2H8c-0.55,0 -1,0.45 -1,1s0.45,1 1,1h8c0.55,0 1,-0.45 1,-1s-0.45,-1 -1,-1h-2v-2h6c1.1,0 2,-0.9 2,-2V5C22,3.9 21.1,3 20,3zM20,15H4V5h16V15z" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="本机名称"
                             Classes="TitleMedium" />
                  <TextBlock x:Name="DisplayNameLabel"
                             Classes="BodyMedium" Foreground="{DynamicResource OnSurfaceVariant}"
                             Text="{Binding DisplayNameDraft}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="EditNameButton"
                        Grid.Column="2"
                        Theme="{StaticResource Md3eFilledTonalIconButtonTheme}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="修改本机名称"
                        Click="OnEditNameClicked">
                  <PathIcon Width="18" Height="18"
                            Data="{DynamicResource Material_IconEdit}"
                            Foreground="{DynamicResource OnSecondaryContainer}" />
                </Button>
              </Grid>
            </controls:ExpressiveGroupTile>

            <controls:ExpressiveGroupTile x:Name="DeviceIdTile" Position="Last">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <controls:ExpressiveIconBadge Grid.Column="0"
                                              ContainerSize="44"
                                              IconSize="22"
                                              Tone="Secondary"
                                              VerticalAlignment="Center"
                                              PathData="M12,1L3,5v6c0,5.55 3.84,10.74 9,12c5.16,-1.26 9,-6.45 9,-12V5L12,1zM12,11.99h7c-0.53,4.12 -3.28,7.79 -7,8.94V12H5V6.3l7,-3.11V11.99z" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="设备编号"
                             Classes="TitleMedium" />
                  <TextBlock x:Name="DeviceIdLabel"
                             Classes="BodyMedium MonoTabular" Foreground="{DynamicResource OnSurfaceVariant}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CopyDeviceIdButton"
                        Grid.Column="2"
                        Theme="{StaticResource Md3eFilledTonalIconButtonTheme}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="复制设备编号"
                        Click="OnCopyDeviceIdClicked">
                  <PathIcon Width="18" Height="18"
                            Data="{DynamicResource Material_IconContentCopy}"
                            Foreground="{DynamicResource OnSecondaryContainer}" />
                </Button>
              </Grid>
            </controls:ExpressiveGroupTile>
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="AppearanceSection" Spacing="10">
          <TextBlock Text="外观与主题"
                     Classes="LabelLarge"
                     Foreground="{DynamicResource Primary}"
                     Margin="8,0,0,0" />
          <StackPanel Spacing="2">
            <controls:ExpressiveGroupTile Position="First" IsInteractive="False">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <controls:ExpressiveIconBadge Grid.Column="0"
                                              ContainerSize="44"
                                              IconSize="22"
                                              Tone="Tertiary"
                                              VerticalAlignment="Top"
                                              PathData="M12,3c-4.97,0 -9,4.03 -9,9s4.03,9 9,9s9,-4.03 9,-9c0,-0.46 -0.04,-0.92 -0.1,-1.36c-0.98,1.37 -2.58,2.26 -4.4,2.26c-2.98,0 -5.4,-2.42 -5.4,-5.4c0,-1.81 0.89,-3.42 2.26,-4.4C12.92,3.04 12.46,3 12,3z" />
                <StackPanel Grid.Column="1" Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="外观模式"
                               Classes="TitleMedium" />
                    <TextBlock Text="跟随系统，或固定浅色 / 深色"
                               Classes="BodyMedium"
                               Foreground="{DynamicResource OnSurfaceVariant}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <controls:ExpressiveButtonGroup x:Name="AppearanceModeGroup"
                                                  HorizontalAlignment="Left" />
                </StackPanel>
              </Grid>
            </controls:ExpressiveGroupTile>

            <controls:ExpressiveGroupTile Position="Last" IsInteractive="False">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <controls:ExpressiveIconBadge Grid.Column="0"
                                              ContainerSize="44"
                                              IconSize="22"
                                              Tone="Secondary"
                                              VerticalAlignment="Top"
                                              PathData="M12,3c-4.97,0 -9,4.03 -9,9c0,4.97 4.03,9 9,9c0.83,0 1.5,-0.67 1.5,-1.5c0,-0.39 -0.15,-0.74 -0.39,-1.01c-0.23,-0.26 -0.38,-0.61 -0.38,-0.99c0,-0.83 0.67,-1.5 1.5,-1.5H16c2.76,0 5,-2.24 5,-5C21,6.58 16.97,3 12,3z" />
                <StackPanel Grid.Column="1" Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="主题配色"
                               Classes="TitleMedium" />
                    <TextBlock Text="跟随桌面强调色，或选用品牌预设"
                               Classes="BodyMedium"
                               Foreground="{DynamicResource OnSurfaceVariant}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <controls:ExpressiveButtonGroup x:Name="AccentSourceGroup"
                                                  HorizontalAlignment="Left" />
                </StackPanel>
              </Grid>
            </controls:ExpressiveGroupTile>
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ServiceSection" Spacing="10">
          <TextBlock Text="文件与后台"
                     Classes="LabelLarge"
                     Foreground="{DynamicResource Primary}"
                     Margin="8,0,0,0" />
          <StackPanel Spacing="2">
            <controls:ExpressiveGroupTile x:Name="DownloadDirTile" Position="First">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <controls:ExpressiveIconBadge Grid.Column="0"
                                              ContainerSize="44"
                                              IconSize="22"
                                              Tone="Secondary"
                                              VerticalAlignment="Center"
                                              PathData="M20,6h-8l-2,-2H4C2.9,4 2.01,4.9 2.01,6L2,18c0,1.1 0.9,2 2,2h16c1.1,0 2,-0.9 2,-2V8C22,6.9 21.1,6 20,6zM20,18H4V8h16V18z" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="文件保存位置"
                             Classes="TitleMedium" />
                  <TextBlock x:Name="DownloadDirLabel"
                             Classes="BodyMedium MonoTabular"
                             Foreground="{DynamicResource OnSurfaceVariant}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <PathIcon Grid.Column="2"
                          Width="18" Height="18"
                          Data="{DynamicResource Material_IconChevronRight}"
                          Foreground="{DynamicResource OnSurfaceVariant}"
                          VerticalAlignment="Center" />
              </Grid>
            </controls:ExpressiveGroupTile>

            <controls:ExpressiveGroupTile Position="Last" IsInteractive="False">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                  <controls:ExpressiveIconBadge Grid.Column="0"
                                                ContainerSize="44"
                                                IconSize="22"
                                                Tone="Primary"
                                                VerticalAlignment="Center"
                                                PathData="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="后台服务与开机自启"
                               Classes="TitleMedium" />
                    <TextBlock x:Name="ServiceStatusDetailText"
                               Classes="BodyMedium"
                               Foreground="{DynamicResource OnSurfaceVariant}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Border x:Name="ServiceStatusPill"
                          Classes="StatusPill"
                          Classes.Muted="{Binding !IsDaemonConnected}"
                          Grid.Column="2"
                          CornerRadius="12"
                          Padding="10,4"
                          VerticalAlignment="Center">
                    <TextBlock x:Name="ServiceStatusBadgeText"
                               Classes="LabelMedium"
                               Text="{Binding ServiceStatusLabel}"
                               VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <controls:ExpressiveButtonGroup x:Name="ServiceActionGroup"
                                                HorizontalAlignment="Left" />
              </StackPanel>
            </controls:ExpressiveGroupTile>
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="WindowSection" Spacing="10">
          <TextBlock Text="窗口"
                     Classes="LabelLarge"
                     Foreground="{DynamicResource Primary}"
                     Margin="8,0,0,0" />
          <StackPanel Spacing="2">
            <controls:ExpressiveGroupTile x:Name="TrayTile" Position="First">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <controls:ExpressiveIconBadge Grid.Column="0"
                                              ContainerSize="44"
                                              IconSize="22"
                                              Tone="Neutral"
                                              VerticalAlignment="Center"
                                              PathData="M4,6h16v10H4V6zm-2,12h20v2H2v-2z" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="关闭窗口时最小化到系统托盘"
                             Classes="TitleMedium"
                             TextWrapping="Wrap" />
                  <TextBlock Text="关闭主窗口后保留在系统托盘中运行"
                             Classes="BodyMedium"
                             Foreground="{DynamicResource OnSurfaceVariant}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <controls:ExpressiveSwitch x:Name="TraySwitch"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
              </Grid>
            </controls:ExpressiveGroupTile>

            <controls:ExpressiveGroupTile x:Name="NativeTitleBarTile" Position="Last">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <controls:ExpressiveIconBadge Grid.Column="0"
                                              ContainerSize="44"
                                              IconSize="22"
                                              Tone="Neutral"
                                              VerticalAlignment="Center"
                                              PathData="M20,4H4C2.9,4 2,4.9 2,6v12c0,1.1 0.9,2 2,2h16c1.1,0 2,-0.9 2,-2V6C22,4.9 21.1,4 20,4zM20,18H4V8h16V18z" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="优先使用系统标题栏"
                             Classes="TitleMedium"
                             TextWrapping="Wrap" />
                  <TextBlock x:Name="TitleBarDescription" Text="正在使用应用标题栏。"
                             Classes="BodyMedium"
                             Foreground="{DynamicResource OnSurfaceVariant}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <controls:ExpressiveSwitch x:Name="NativeTitleBarSwitch"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
              </Grid>
            </controls:ExpressiveGroupTile>
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="HelpSection" Spacing="10">
          <TextBlock Text="帮助"
                     Classes="LabelLarge"
                     Foreground="{DynamicResource Primary}"
                     Margin="8,0,0,0" />
          <StackPanel Spacing="2">
            <controls:ExpressiveGroupTile x:Name="GuideTile" Position="First">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <controls:ExpressiveIconBadge Grid.Column="0"
                                              ContainerSize="44"
                                              IconSize="22"
                                              Tone="Secondary"
                                              VerticalAlignment="Center"
                                              PathData="M11,18h2v-2h-2V18zM12,2C6.48,2 2,6.48 2,12s4.48,10 10,10s10,-4.48 10,-10S17.52,2 12,2zM12,20c-4.41,0 -8,-3.59 -8,-8s3.59,-8 8,-8s8,3.59 8,8S16.41,20 12,20zM12,6c-2.21,0 -4,1.79 -4,4h2c0,-1.1 0.9,-2 2,-2s2,0.9 2,2c0,2 -3,1.75 -3,5h2c0,-2.25 3,-2.5 3,-5C16,7.79 14.21,6 12,6z" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="使用指引"
                             Classes="TitleMedium" />
                  <TextBlock Text="局域网发现、配对码核对、剪贴板共享与断点续传"
                             Classes="BodyMedium"
                             Foreground="{DynamicResource OnSurfaceVariant}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <PathIcon Grid.Column="2"
                          Width="18" Height="18"
                          Data="{DynamicResource Material_IconChevronRight}"
                          Foreground="{DynamicResource OnSurfaceVariant}"
                          VerticalAlignment="Center" />
              </Grid>
            </controls:ExpressiveGroupTile>

            <controls:ExpressiveGroupTile x:Name="AboutTile" Position="Last">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <controls:ContextAllLogo Grid.Column="0"
                                         LogoSize="44"
                                         VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="关于 ContextAll"
                             Classes="TitleMedium" />
                  <TextBlock x:Name="AboutEntrySummaryText"
                             Classes="BodyMedium MonoTabular"
                             Foreground="{DynamicResource OnSurfaceVariant}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <PathIcon Grid.Column="2"
                          Width="18" Height="18"
                          Data="{DynamicResource Material_IconChevronRight}"
                          Foreground="{DynamicResource OnSurfaceVariant}"
                          VerticalAlignment="Center" />
              </Grid>
            </controls:ExpressiveGroupTile>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    </Grid>

    <controls:MaterialDialog x:Name="RenameDialogControl"
                             Title="修改本机名称"
                             PrimaryActionText="保存"
                             CancelActionText="取消"
                             DismissOnScrimClick="True">
      <controls:MaterialDialog.BodyContent>
        <TextBox x:Name="NameInput"
                 Classes="Filled"
                 PlaceholderText="输入本机名称"
                 TextChanged="OnNameInputTextChanged" />
      </controls:MaterialDialog.BodyContent>
    </controls:MaterialDialog>

    <controls:MaterialDialog x:Name="AboutDialogControl"
                             Title="关于 ContextAll"
                             PrimaryActionText="关闭"
                             CancelActionText=""
                             DismissOnScrimClick="True">
      <controls:MaterialDialog.BodyContent>
        <ScrollViewer MaxHeight="420"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
              <controls:ContextAllLogo LogoSize="56" HorizontalAlignment="Center" />
              <TextBlock Text="ContextAll"
                         Classes="TitleLargeEmphasized"
                         HorizontalAlignment="Center" />
              <Border CornerRadius="16"
                      Background="{DynamicResource PrimaryContainer}"
                      Padding="12,4"
                      HorizontalAlignment="Center">
                <TextBlock x:Name="AboutVersionText"
                           Classes="LabelMedium MonoTabular"
                           Foreground="{DynamicResource OnPrimaryContainer}" />
              </Border>
              <TextBlock Text="轻快、私密的局域网跨设备剪贴板同步与文件互传工具"
                         Classes="BodySmall"
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border CornerRadius="20"
                    Background="{DynamicResource SurfaceContainerLow}"
                    Padding="16,12">
              <StackPanel Spacing="4">
                <TextBlock Text="通信协议与加密"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource OnSurfaceVariant}" />
                <TextBlock x:Name="AboutProtocolText"
                           Classes="BodySmall MonoTabular"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border CornerRadius="20"
                    Background="{DynamicResource SurfaceContainerLow}"
                    Padding="16,12">
              <StackPanel Spacing="6">
                <TextBlock Text="本机运行环境"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource OnSurfaceVariant}" />

                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="操作系统" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutOsDescriptionText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="系统版本" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutOsVersionText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="处理器" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutCpuText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="图形会话" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutDisplayServerText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="剪贴板后端" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutClipboardBackendText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="设备编号" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutDeviceIdText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="CopyDiagnosticsButton"
                      Content="复制本机与版本信息"
                      Classes="FilledTonal"
                      VerticalAlignment="Center"
                      CornerRadius="20"
                      Padding="16,8"
                      Click="OnCopyDiagnosticsClicked" />
              <TextBlock x:Name="AboutCopyFeedbackText"
                         Classes="BodySmall"
                         Foreground="{DynamicResource Primary}"
                         VerticalAlignment="Center"
                         IsVisible="False" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </controls:MaterialDialog.BodyContent>
    </controls:MaterialDialog>
  </Panel>
</UserControl>
