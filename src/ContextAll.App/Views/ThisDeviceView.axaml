<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ContextAll.App.ViewModels"
             xmlns:controls="using:ContextAll.App.Controls"
             x:Class="ContextAll.App.Views.ThisDeviceView"
             x:DataType="vm:ThisDeviceViewModel">

  <Panel>
    <ScrollViewer Padding="4,0,4,16"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Text="本机设置"
                     Classes="HeadlineSmall" />
          <TextBlock Text="管理本机名称、文件保存位置、外观配色与后台服务"
                     Classes="BodyMedium"
                     Foreground="{DynamicResource OnSurfaceVariant}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="StatusBanner"
                CornerRadius="16"
                Padding="14,10"
                IsVisible="False">
          <TextBlock x:Name="StatusText"
                     Classes="BodyMedium"
                     TextWrapping="Wrap" />
        </Border>

        <!-- PrimaryContainer Identity Hero Card -->
        <Border CornerRadius="28"
                Padding="20"
                Background="{DynamicResource PrimaryContainer}">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <controls:ExpressiveIconBadge ContainerSize="44"
                                            IconSize="22"
                                            Tone="Primary"
                                            PathData="M4 6h16v10H4V6zm-2 12h20v2H2v-2z" />
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="本机信息"
                           Classes="TitleMedium"
                           Foreground="{DynamicResource OnPrimaryContainer}" />
                <TextBlock x:Name="DeviceIdLabel"
                           Classes="BodySmall MonoTabular"
                           Foreground="{DynamicResource OnPrimaryContainer}" />
              </StackPanel>
            </StackPanel>

            <TextBlock Text="本机名称"
                       Classes="LabelMedium"
                       Foreground="{DynamicResource OnPrimaryContainer}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="NameInput"
                       Grid.Column="0"
                       Classes="Outlined"
                       PlaceholderText="输入本机名称"
                       TextChanged="OnNameInputTextChanged" />
              <Button Grid.Column="1"
                      Content="保存名称"
                      Classes="Filled"
                      VerticalAlignment="Center"
                      CornerRadius="20"
                      Padding="16,10"
                      Click="OnSaveNameClicked" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Storage Path Card -->
        <controls:ExpressiveGroupTile Position="First" IsInteractive="False">
          <StackPanel Spacing="10">
            <TextBlock Text="文件保存位置"
                       Classes="TitleMedium" />
            <TextBlock x:Name="DownloadDirLabel"
                       Classes="BodyMedium MonoTabular"
                       Foreground="{DynamicResource OnSurfaceVariant}"
                       TextWrapping="Wrap" />
            <Button Content="选择保存文件夹…"
                    Classes="FilledTonal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    Padding="16,8"
                    Click="OnChooseFolderClicked" />
          </StackPanel>
        </controls:ExpressiveGroupTile>

        <!-- Theme & Accent Overrides -->
        <controls:ExpressiveGroupTile Position="Middle" IsInteractive="False">
          <StackPanel Spacing="12">
            <TextBlock Text="外观与主题配色"
                       Classes="TitleMedium" />

            <StackPanel Spacing="6">
              <TextBlock Text="外观模式"
                         Classes="LabelMedium"
                         Foreground="{DynamicResource OnSurfaceVariant}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ModeFollowButton"
                        Content="跟随系统"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Padding="14,7"
                        Click="OnModeFollowClicked" />
                <Button x:Name="ModeLightButton"
                        Content="浅色"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Padding="14,7"
                        Click="OnModeLightClicked" />
                <Button x:Name="ModeDarkButton"
                        Content="深色"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Padding="14,7"
                        Click="OnModeDarkClicked" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="主题配色"
                         Classes="LabelMedium"
                         Foreground="{DynamicResource OnSurfaceVariant}" />
              <WrapPanel Orientation="Horizontal">
                <Button x:Name="AccentFollowButton"
                        Content="跟随系统"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Padding="14,7"
                        Margin="0,0,8,8"
                        Click="OnAccentFollowClicked" />
                <Button x:Name="AccentBlueButton"
                        Content="品牌蓝"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Padding="14,7"
                        Margin="0,0,8,8"
                        Click="OnAccentBlueClicked" />
                <Button x:Name="AccentTealButton"
                        Content="森林青"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Padding="14,7"
                        Margin="0,0,8,8"
                        Click="OnAccentTealClicked" />
                <Button x:Name="AccentSunsetButton"
                        Content="日落陶红"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Padding="14,7"
                        Margin="0,0,8,8"
                        Click="OnAccentSunsetClicked" />
                <Button x:Name="AccentVioletButton"
                        Content="紫罗兰"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Padding="14,7"
                        Margin="0,0,8,8"
                        Click="OnAccentVioletClicked" />
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </controls:ExpressiveGroupTile>

        <!-- Window & Tray Behavior -->
        <controls:ExpressiveGroupTile Position="Middle" IsInteractive="False">
          <StackPanel Spacing="12">
            <TextBlock Text="窗口与托盘行为"
                       Classes="TitleMedium" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="关闭窗口时最小化到系统托盘"
                           Classes="TitleSmall" />
                <TextBlock Text="关闭主窗口后保留在系统托盘中运行（需桌面环境支持系统托盘）"
                           Classes="BodySmall"
                           Foreground="{DynamicResource OnSurfaceVariant}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <controls:ExpressiveSwitch x:Name="TraySwitch"
                                         Grid.Column="1"
                                         VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="使用系统原生窗口标题栏"
                           Classes="TitleSmall" />
                <TextBlock Text="开启后由桌面窗口管理器绘制标题栏与窗口按钮"
                           Classes="BodySmall"
                           Foreground="{DynamicResource OnSurfaceVariant}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <controls:ExpressiveSwitch x:Name="NativeTitleBarSwitch"
                                         Grid.Column="1"
                                         VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </controls:ExpressiveGroupTile>

        <!-- Background Service Status & Autostart -->
        <controls:ExpressiveGroupTile Position="Middle" IsInteractive="False">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Grid.Column="0"
                         Text="后台服务与开机自启"
                         Classes="TitleMedium"
                         VerticalAlignment="Center" />
              <Border x:Name="ServiceStatusPill"
                      Grid.Column="1"
                      CornerRadius="12"
                      Padding="10,4"
                      VerticalAlignment="Center">
                <TextBlock x:Name="ServiceStatusBadgeText"
                           Classes="LabelMedium"
                           VerticalAlignment="Center" />
              </Border>
            </Grid>

            <TextBlock x:Name="ServiceStatusDetailText"
                       Classes="BodySmall"
                       Foreground="{DynamicResource OnSurfaceVariant}"
                       TextWrapping="Wrap" />

            <TextBlock Text="保持后台服务开机自启，关闭窗口后仍可继续接收文件与同步剪贴板。"
                       Classes="BodySmall"
                       Foreground="{DynamicResource OnSurfaceVariant}"
                       TextWrapping="Wrap" />

            <WrapPanel Orientation="Horizontal">
              <Button x:Name="AutostartButton"
                      Classes="FilledTonal"
                      VerticalAlignment="Center"
                      CornerRadius="20"
                      Padding="16,10"
                      Margin="0,0,8,8"
                      Click="OnAutostartClicked" />
              <Button x:Name="ReconnectDaemonButton"
                      Content="启动后台服务"
                      Classes="Filled"
                      VerticalAlignment="Center"
                      CornerRadius="20"
                      Padding="16,10"
                      Margin="0,0,8,8"
                      Click="OnStartDaemonClicked" />
            </WrapPanel>
          </StackPanel>
        </controls:ExpressiveGroupTile>

        <!-- Usage Guide Entry -->
        <controls:ExpressiveGroupTile x:Name="GuideTile"
                                      Position="Middle"
                                      IsInteractive="True">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <controls:ExpressiveIconBadge Grid.Column="0"
                                          ContainerSize="40"
                                          IconSize="20"
                                          Tone="Secondary"
                                          VerticalAlignment="Center"
                                          PathData="M11,18h2v-2h-2V18zM12,2C6.48,2 2,6.48 2,12s4.48,10 10,10s10,-4.48 10,-10S17.52,2 12,2zM12,20c-4.41,0 -8,-3.59 -8,-8s3.59,-8 8,-8s8,3.59 8,8S16.41,20 12,20zM12,6c-2.21,0 -4,1.79 -4,4h2c0,-1.1 0.9,-2 2,-2s2,0.9 2,2c0,2 -3,1.75 -3,5h2c0,-2.25 3,-2.5 3,-5C16,7.79 14.21,6 12,6z" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="使用指引"
                         Classes="TitleMedium" />
              <TextBlock Text="了解局域网发现、6 位配对码核对、剪贴板共享与断点续传"
                         Classes="BodySmall"
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="OpenGuideButton"
                    Grid.Column="2"
                    Content="查看指引"
                    Classes="FilledTonal"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    Padding="14,7"
                    Click="OnOpenGuideClicked" />
          </Grid>
        </controls:ExpressiveGroupTile>

        <!-- About ContextAll & Host Diagnostics Entry -->
        <controls:ExpressiveGroupTile x:Name="AboutTile"
                                      Position="Last"
                                      IsInteractive="True">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <controls:ContextAllLogo Grid.Column="0"
                                     LogoSize="40"
                                     VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="关于 ContextAll"
                         Classes="TitleMedium" />
              <TextBlock x:Name="AboutEntrySummaryText"
                         Classes="BodySmall MonoTabular"
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextWrapping="Wrap" />
              <TextBlock Text="查看加密协议、运行环境参数与版本信息"
                         Classes="BodySmall"
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="OpenAboutButton"
                    Grid.Column="2"
                    Content="查看详情"
                    Classes="FilledTonal"
                    VerticalAlignment="Center"
                    CornerRadius="20"
                    Padding="14,7"
                    Click="OnOpenAboutClicked" />
          </Grid>
        </controls:ExpressiveGroupTile>
      </StackPanel>
    </ScrollViewer>

    <!-- About & Host Diagnostics Modal -->
    <controls:MaterialDialog x:Name="AboutDialogControl"
                             Title="关于 ContextAll"
                             PrimaryActionText="关闭"
                             CancelActionText=""
                             DismissOnScrimClick="True">
      <controls:MaterialDialog.BodyContent>
        <ScrollViewer MaxHeight="420"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
              <controls:ContextAllLogo LogoSize="56" HorizontalAlignment="Center" />
              <TextBlock Text="ContextAll"
                         Classes="TitleLargeEmphasized"
                         HorizontalAlignment="Center" />
              <Border CornerRadius="16"
                      Background="{DynamicResource PrimaryContainer}"
                      Padding="12,4"
                      HorizontalAlignment="Center">
                <TextBlock x:Name="AboutVersionText"
                           Classes="LabelMedium MonoTabular"
                           Foreground="{DynamicResource OnPrimaryContainer}" />
              </Border>
              <TextBlock Text="轻快、私密的局域网跨设备剪贴板同步与文件互传工具"
                         Classes="BodySmall"
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border CornerRadius="16"
                    Background="{DynamicResource SurfaceContainer}"
                    Padding="14,10">
              <StackPanel Spacing="4">
                <TextBlock Text="通信协议与加密"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource OnSurfaceVariant}" />
                <TextBlock x:Name="AboutProtocolText"
                           Classes="BodySmall MonoTabular"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border CornerRadius="16"
                    Background="{DynamicResource SurfaceContainer}"
                    Padding="14,10">
              <StackPanel Spacing="6">
                <TextBlock Text="本机运行环境"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource OnSurfaceVariant}" />

                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="操作系统" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutOsDescriptionText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="系统版本" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutOsVersionText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="处理器" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutCpuText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="图形会话" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutDisplayServerText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="剪贴板后端" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutClipboardBackendText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="设备编号" Classes="BodySmall" Foreground="{DynamicResource OnSurfaceVariant}" />
                  <TextBlock x:Name="AboutDeviceIdText" Grid.Column="1" Classes="BodySmall MonoTabular" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="CopyDiagnosticsButton"
                      Content="复制本机与版本信息"
                      Classes="FilledTonal"
                      VerticalAlignment="Center"
                      CornerRadius="20"
                      Padding="16,8"
                      Click="OnCopyDiagnosticsClicked" />
              <TextBlock x:Name="AboutCopyFeedbackText"
                         Classes="BodySmall"
                         Foreground="{DynamicResource Primary}"
                         VerticalAlignment="Center"
                         IsVisible="False" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </controls:MaterialDialog.BodyContent>
    </controls:MaterialDialog>
  </Panel>
</UserControl>
