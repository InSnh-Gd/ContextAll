<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ContextAll.App.Controls"
             xmlns:vm="using:ContextAll.App.ViewModels"
             x:Class="ContextAll.App.Views.ConnectionView"
             x:DataType="vm:ConnectionViewModel">
  <Panel>
    <ScrollViewer Padding="16,8,16,24"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
          <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="连接与网络" Classes="HeadlineSmallEmphasized" Foreground="{DynamicResource OnSurface}" />
            <TextBlock Text="查看本机局域网地址、设备连接状态，或通过 IP 手动直连"
                       Classes="BodyMedium"
                       Foreground="{DynamicResource OnSurfaceVariant}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel x:Name="HeaderActions" Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">
            <Border x:Name="ClipboardStatusPill"
                    Classes="StatusPill"
                    CornerRadius="12"
                    Padding="10,4"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="剪贴板"
                           Classes="LabelMedium"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ClipboardStatusLabel"
                           Text="{Binding ClipboardStatusText}"
                           Classes="LabelMedium"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Button Classes="FilledTonal"
                    Content="使用指南"
                    CornerRadius="20"
                    Padding="16,9"
                    VerticalAlignment="Center"
                    Click="OnOpenGuideClicked" />
          </StackPanel>
        </Grid>

        <Grid x:Name="DesktopSplitGrid" ColumnSpacing="12" RowSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border x:Name="DialPane" CornerRadius="28" Background="{DynamicResource Surface}" Padding="20">
            <StackPanel Spacing="12">
              <TextBlock Text="手动输入地址连接"
                         Classes="TitleMediumEmphasized"
                         Foreground="{DynamicResource OnSurface}" />
              <TextBlock Text="未自动搜到设备或需要跨网段直连时，输入对方 IP（可省略端口，默认 42461）。"
                         Classes="BodySmall"
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextWrapping="Wrap" />

              <StackPanel Spacing="6">
                <TextBlock Text="对方地址"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource OnSurfaceVariant}" />
                <TextBox x:Name="EndpointBox"
                         Classes="Outlined MonoTabular" CornerRadius="20" MinHeight="56" Padding="16,8"
                         AutomationProperties.Name="对方地址"
                         PlaceholderText="例如 192.168.1.10"
                         Text="{Binding EndpointInput, Mode=TwoWay}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="快捷填入"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource OnSurfaceVariant}" />
                <c:ExpressiveButtonGroup x:Name="LanPresetGroup" HorizontalAlignment="Left" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="设备备注（选填）"
                           Classes="LabelMedium"
                           Foreground="{DynamicResource OnSurfaceVariant}" />
                <TextBox x:Name="AliasBox"
                         Classes="Outlined" CornerRadius="20" MinHeight="56" Padding="16,8"
                         AutomationProperties.Name="设备备注（选填）"
                         PlaceholderText="给这台设备起个容易认的名字"
                         Text="{Binding AliasInput, Mode=TwoWay}" />
              </StackPanel>

              <Button Classes="Filled"
                      Content="发起连接"
                      CornerRadius="20"
                      Padding="20,10"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Click="OnDialClicked" />

              <Border x:Name="FeedbackBanner"
                      Classes="StatusPill"
                      Classes.Error="{Binding DialIsError}"
                      CornerRadius="16"
                      Padding="14,10"
                      IsVisible="{Binding HasDialFeedback}">
                <TextBlock x:Name="FeedbackLabel"
                           Text="{Binding DialFeedback}"
                           Classes="BodySmall"
                           TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>

          <Border x:Name="InfoPane" Grid.Column="1" CornerRadius="28" Padding="16" Background="{DynamicResource Surface}">
          <StackPanel Spacing="16">
            <StackPanel Spacing="10">
              <TextBlock Text="本机可达地址"
                         Classes="LabelLarge"
                         Foreground="{DynamicResource Primary}"
                         Margin="8,0,0,0" />
              <c:ExpressiveGroupTile Position="Single"
                                     IsInteractive="False"
                                     Padding="18,16"
                                     IsVisible="{Binding !HasLocalEndpoints}">
                <TextBlock Text="暂未检测到可用的局域网地址，确认网络已连接后会自动刷新。"
                           Classes="BodyMedium"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource OnSurfaceVariant}" />
              </c:ExpressiveGroupTile>
              <ItemsControl ItemsSource="{Binding EndpointItems}" IsVisible="{Binding HasLocalEndpoints}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EndpointRowItem">
                    <c:ExpressiveGroupTile Position="{Binding Position}" IsInteractive="False" Padding="18,14">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <c:ExpressiveIconBadge Tone="Primary"
                                               ContainerSize="40"
                                               IconSize="20"
                                               PathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM12,20c-4.41,0 -8,-3.59 -8,-8s3.59,-8 8,-8 8,3.59 8,8 -3.59,8 -8,8z" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Endpoint}"
                                   Classes="BodyMedium MonoTabular"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="2"
                                Classes="FilledTonal"
                                Content="复制"
                                CornerRadius="20"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Command="{Binding CopyCommand}"
                                CommandParameter="{Binding Endpoint}" />
                      </Grid>
                    </c:ExpressiveGroupTile>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="10">
              <TextBlock Text="传输加密与网络参数"
                         Classes="LabelLarge"
                         Foreground="{DynamicResource Primary}"
                         Margin="8,0,0,0" />
              <StackPanel Spacing="2">
                <c:ExpressiveGroupTile Position="First" IsInteractive="False" Padding="18,14">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <c:ExpressiveIconBadge Grid.Column="0"
                                           Tone="Secondary"
                                           ContainerSize="40"
                                           IconSize="20"
                                           PathData="M3.9,12c0,-1.71 1.39,-3.1 3.1,-3.1h4V7H7c-2.76,0 -5,2.24 -5,5s2.24,5 5,5h4v-1.9H7C5.29,15.1 3.9,13.71 3.9,12zM8,13h8v-2H8v2zM17,7h-4v1.9h4c1.71,0 3.1,1.39 3.1,3.1s-1.39,3.1 -3.1,3.1h-4V17h4c2.76,0 5,-2.24 5,-5S19.76,7 17,7z" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="局域网直连通道"
                                 Classes="BodySmall"
                                 Foreground="{DynamicResource OnSurfaceVariant}" />
                      <TextBlock x:Name="QuicSpecValue"
                                 Text="{Binding QuicSpecText}"
                                 Classes="TitleSmall MonoTabular"
                                 Foreground="{DynamicResource OnSurface}" />
                    </StackPanel>
                  </Grid>
                </c:ExpressiveGroupTile>

                <c:ExpressiveGroupTile Position="Last" IsInteractive="False" Padding="18,14">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <c:ExpressiveIconBadge Grid.Column="0"
                                           Tone="Tertiary"
                                           ContainerSize="40"
                                           IconSize="20"
                                           PathData="M12,1L3,5v6c0,5.55 3.84,10.74 9,12c5.16,-1.26 9,-6.45 9,-12V5L12,1zM12,11.99h7c-0.53,4.12 -3.28,7.79 -7,8.94V12H5V6.3l7,-3.11V11.99z" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="安全校验机制"
                                 Classes="BodySmall"
                                 Foreground="{DynamicResource OnSurfaceVariant}" />
                      <TextBlock Text="ECDSA P-256 双向认证 · SHA-256 分块检验"
                                 Classes="TitleSmall"
                                 Foreground="{DynamicResource OnSurface}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </c:ExpressiveGroupTile>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          </Border>
        </Grid>

        <StackPanel Spacing="10" Margin="0,0,0,8">
          <TextBlock x:Name="PeersSectionLabel"
                     Text="{Binding PeersSectionTitle}"
                     Classes="LabelLarge"
                     Foreground="{DynamicResource Primary}"
                     Margin="8,0,0,0" />
          <c:ExpressiveGroupTile Position="Single"
                                 IsInteractive="False"
                                 Padding="18,16"
                                 IsVisible="{Binding !HasDevices}">
            <TextBlock Text="当前还没有已配对或已发现的设备，可在「设备」页搜索，或输入对方地址手动连接。"
                       Classes="BodyMedium"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource OnSurfaceVariant}" />
          </c:ExpressiveGroupTile>
          <ItemsControl ItemsSource="{Binding PeerOverviewItems}" IsVisible="{Binding HasDevices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PeerOverviewItem">
                <c:ExpressiveGroupTile Position="{Binding Position}" IsInteractive="False" Padding="18,14">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <c:ExpressiveIconBadge Tone="{Binding PresenceTone}"
                                           ContainerSize="40"
                                           IconSize="20"
                                           PathData="M4,6h18V4H4C2.9,4 2,4.9 2,6v11H0v3h14v-3H4V6zM23,8h-6c-0.55,0 -1,0.45 -1,1v10c0,0.55 0.45,1 1,1h6c0.55,0 1,-0.45 1,-1V9C24,8.45 23.55,8 23,8zM22,17h-4v-7h4V17z" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding DisplayName}" Classes="TitleSmall" VerticalAlignment="Center" />
                        <Border CornerRadius="12" Padding="8,3" Background="{DynamicResource SecondaryContainer}"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding PresenceLabel}"
                                     Classes="LabelSmallEmphasized"
                                     Foreground="{DynamicResource OnSecondaryContainer}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding EndpointLabel}"
                                 Classes="BodySmall MonoTabular"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource OnSurfaceVariant}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="FilledTonal"
                            Content="配对"
                            CornerRadius="20"
                            Padding="14,6"
                            IsVisible="{Binding !IsTrusted}"
                            Command="{Binding StartPairingCommand}"
                            CommandParameter="{Binding DeviceId}" />
                    <TextBlock Grid.Column="2"
                               Text="已配对"
                               Classes="LabelMedium"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsTrusted}"
                               Foreground="{DynamicResource OnSurfaceVariant}" />
                  </Grid>
                </c:ExpressiveGroupTile>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <c:MaterialDialog x:Name="GuideDialogControl"
                      Title="ContextAll 使用指南"
                      PrimaryActionText="我知道了"
                      CancelActionText=""
                      DismissOnScrimClick="True"
                      IsOpen="{Binding IsGuideOpen}">
      <c:MaterialDialog.BodyContent>
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border CornerRadius="16"
                    Padding="10,4"
                    Background="{DynamicResource SecondaryContainer}"
                    HorizontalAlignment="Left">
              <TextBlock Text="{Binding GuideStepCounterText}"
                         Classes="LabelMediumEmphasized"
                         Foreground="{DynamicResource OnSecondaryContainer}"
                         VerticalAlignment="Center" />
            </Border>
            <ItemsControl Grid.Column="1"
                          ItemsSource="{Binding GuideDots}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GuideDotItem">
                  <Border Classes="GuideDot"
                          Classes.Active="{Binding IsActive}"
                          Width="{Binding DotWidth}"
                          Height="8"
                          CornerRadius="4"
                          VerticalAlignment="Center" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <Border CornerRadius="20"
                  Padding="16"
                  Background="{DynamicResource SurfaceContainer}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding CurrentGuideStep.Tag}"
                         Classes="LabelLargeEmphasized"
                         Foreground="{DynamicResource Primary}" />
              <TextBlock Text="{Binding CurrentGuideStep.Title}"
                         Classes="TitleMediumEmphasized"
                         Foreground="{DynamicResource OnSurface}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding CurrentGuideStep.Description}"
                         Classes="BodyMedium"
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button Classes="Outlined"
                    Content="上一步"
                    CornerRadius="20"
                    Padding="14,7"
                    VerticalAlignment="Center"
                    IsVisible="{Binding CanGoPreviousGuideStep}"
                    Command="{Binding PreviousGuideStepCommand}" />
            <Button Classes="FilledTonal"
                    Content="下一步"
                    CornerRadius="20"
                    Padding="16,7"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !IsLastGuideStep}"
                    Command="{Binding NextGuideStepCommand}" />
            <Button Classes="FilledTonal"
                    Content="完成"
                    CornerRadius="20"
                    Padding="16,7"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsLastGuideStep}"
                    Command="{Binding CloseGuideCommand}" />
          </StackPanel>
        </StackPanel>
      </c:MaterialDialog.BodyContent>
    </c:MaterialDialog>
  </Panel>
</UserControl>
